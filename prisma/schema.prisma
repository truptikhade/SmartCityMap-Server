// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  schemas           = ["auth", "geo", "transit", "booking", "public"]
}

// ─── AUTH SCHEMA ─────────────────────────────────────────

model User {
  id           String    @id @default(uuid())
  fname        String
  lname        String?
  email        String    @unique
  phone        String    @unique
  passwordHash String    @map("password_hash")
  profilePic   String?   @map("profile_pic")
  homeAddress  String?   @map("home_address")
  role         String    @default("user")   // user | admin | driver
  isVerified   Boolean   @default(false)    @map("is_verified")
  isActive     Boolean   @default(true)     @map("is_active")
  lastLogin    DateTime? @map("last_login")
  createdAt    DateTime  @default(now())    @map("created_at")
  updatedAt    DateTime  @updatedAt         @map("updated_at")

  // Relations
  savedRoutes  SavedRoute[]
  reviews      Review[]
  bookings     Booking[]

  @@map("users")
  @@schema("auth")
}

model SavedRoute {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  label     String
  fromLat   Float    @map("from_lat")
  fromLng   Float    @map("from_lng")
  toLat     Float    @map("to_lat")
  toLng     Float    @map("to_lng")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("saved_routes")
  @@schema("auth")
}

model Review {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  placeId   String   @map("place_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@map("reviews")
  @@schema("auth")
}

// ─── GEO SCHEMA ──────────────────────────────────────────

model Place {
  id                 String   @id @default(uuid())
  name               String
  category           String
  address            String?
  rating             Float    @default(0)
  openHours          String?
  lat                Float
  lng                Float
  createdAt          DateTime @default(now())
  osmId              String?  @unique   // ← add this line
  reviews            Review[]
  nearbySpecialties  NearbySpecialty[]

  @@map("places")
  @@schema("geo")
}

model NearbySpecialty {
  id            String   @id @default(uuid())
  placeId       String   @map("place_id")
  specialtyType String   @map("specialty_type")
  aiScore       Float?   @map("ai_score")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  place         Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@map("nearby_specialties")
  @@schema("geo")
}

model Route {
  id          String     @id @default(uuid())
  name        String
  transitType String
  startPoint  String
  endPoint    String
  baseFare    Float
  perKmRate   Float
  isActive    Boolean    @default(true)
  stops       Stop[]
  schedules   Schedule[]

  @@schema("geo")
}

model Stop {
  id       String @id @default(uuid())
  routeId  String
  route    Route  @relation(fields: [routeId], references: [id])
  name     String
  lat      Float
  lng      Float
  sequence Int

  @@schema("geo")
}

model Schedule {
  id            String   @id @default(uuid())
  routeId       String
  route         Route    @relation(fields: [routeId], references: [id])
  departureTime String
  arrivalTime   String
  daysActive    String[]
  vehicleNumber String?

  @@schema("geo")
}

// ─── TRANSIT SCHEMA ──────────────────────────────────────

model TransitRoute {
  id               String   @id @default(uuid())
  routeName        String   @map("route_name")
  routeNumber      String   @unique @map("route_number")
  transitType      String   @map("transit_type") // bus | train | auto
  origin           String
  destination      String
  originLat        Float    @map("origin_lat")
  originLng        Float    @map("origin_lng")
  destinationLat   Float    @map("destination_lat")
  destinationLng   Float    @map("destination_lng")
  baseFare         Float    @map("base_fare")
  firstDeparture   String?  @map("first_departure") // "06:00"
  lastDeparture    String?  @map("last_departure")  // "23:00"
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")

  // Relations
  stops            TransitStop[]
  trips            Trip[]
  bookings         Booking[]

  @@map("transit_routes")
  @@schema("transit")
}

model TransitStop {
  id                 String   @id @default(uuid())
  routeId            String   @map("route_id")
  stopName           String   @map("stop_name")
  stopCode           String?  @map("stop_code")
  stopOrder          Int      @map("stop_order")
  lat                Float
  lng                Float
  arrivalTime        String?  @map("arrival_time")
  departureTime      String?  @map("departure_time")
  distanceFromPrevKm Float?   @map("distance_from_prev_km")

  // Relations
  route              TransitRoute  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  currentTrackings   LiveTracking[] @relation("CurrentStop")
  nextTrackings      LiveTracking[] @relation("NextStop")
  boardingBookings   Booking[]      @relation("BoardingStop")
  dropBookings       Booking[]      @relation("DropStop")

  @@unique([routeId, stopOrder])
  @@map("transit_stops")
  @@schema("transit")
}

model Trip {
  id             String   @id @default(uuid())
  routeId        String   @map("route_id")
  vehicleNumber  String   @map("vehicle_number")
  vehicleType    String   @map("vehicle_type")
  driverName     String?  @map("driver_name")
  driverPhone    String?  @map("driver_phone")
  departureTime  String   @map("departure_time")
  arrivalTime    String?  @map("arrival_time")
  travelDate     DateTime @map("travel_date")
  status         String   @default("scheduled")
  // scheduled | running | completed | cancelled
  totalSeats     Int      @map("total_seats")
  availableSeats Int      @map("available_seats")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  route          TransitRoute  @relation(fields: [routeId], references: [id], onDelete: Restrict)
  liveTracking   LiveTracking?
  bookings       Booking[]

  @@map("trips")
  @@schema("transit")
}

model LiveTracking {
  id             String   @id @default(uuid())
  tripId         String   @unique @map("trip_id") // UNIQUE = 1:1 with Trip
  currentStopId  String?  @map("current_stop_id")
  nextStopId     String?  @map("next_stop_id")
  currentLat     Float    @map("current_lat")
  currentLng     Float    @map("current_lng")
  delayMinutes   Int      @default(0) @map("delay_minutes")
  speedKmph      Float?   @map("speed_kmph")
  bearing        Float?
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  trip           Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  currentStop    TransitStop? @relation("CurrentStop", fields: [currentStopId], references: [id], onDelete: SetNull)
  nextStop       TransitStop? @relation("NextStop",    fields: [nextStopId],    references: [id], onDelete: SetNull)

  @@map("live_tracking")
  @@schema("transit")
}

// ─── BOOKING SCHEMA ───────────────────────────────────────

model Booking {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  routeId         String   @map("route_id")
  tripId          String?  @map("trip_id")
  boardingStopId  String?  @map("boarding_stop_id")
  dropStopId      String?  @map("drop_stop_id")
  transitType     String   @map("transit_type")
  seatNumber      String?  @map("seat_number")
  farePaid        Float    @map("fare_paid")
  travelDate      DateTime @map("travel_date")
  status          String   @default("pending")
  // pending | confirmed | cancelled | completed
  bookedAt        DateTime @default(now()) @map("booked_at")

  // Relations
  user            User         @relation(fields: [userId],         references: [id], onDelete: Restrict)
  route           TransitRoute @relation(fields: [routeId],        references: [id], onDelete: Restrict)
  trip            Trip?        @relation(fields: [tripId],         references: [id], onDelete: Restrict)
  boardingStop    TransitStop? @relation("BoardingStop", fields: [boardingStopId], references: [id], onDelete: SetNull)
  dropStop        TransitStop? @relation("DropStop",    fields: [dropStopId],     references: [id], onDelete: SetNull)
  payment         Payment?

  @@map("bookings")
  @@schema("booking")
}

model Payment {
  id            String    @id @default(uuid())
  bookingId     String    @unique @map("booking_id") // UNIQUE = 1:1 with Booking
  amount        Float
  method        String
  status        String    @default("pending")
  transactionId String?   @unique @map("transaction_id")
  paidAt        DateTime? @map("paid_at")

  // Relations
  booking       Booking   @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@map("payments")
  @@schema("booking")
}