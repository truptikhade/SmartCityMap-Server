// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "geo", "transit", "booking", "public"]
}

// ─────────────────────────────────────────────────────────
// AUTH SCHEMA
// ─────────────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid())
  fname        String
  lname        String?
  email        String    @unique
  phone        String    @unique
  passwordHash String    @map("password_hash")
  resetPasswordToken   String?   @map("reset_password_token")
  resetPasswordExpires DateTime? @map("reset_password_expires")
  
  emailVerificationToken    String?   @map("email_verification_token")
  emailVerificationExpires  DateTime? @map("email_verification_expires")

  profilePic   String?   @map("profile_pic")
  homeAddress  String?   @map("home_address")

  role         String    @default("user") // user | admin | driver

  isVerified   Boolean   @default(false) @map("is_verified")
  isActive     Boolean   @default(true) @map("is_active")
  
  lastLogin    DateTime? @map("last_login")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Existing relations
  savedRoutes SavedRoute[]
  reviews     Review[]
  bookings    Booking[]

  // Driver
  driverProfile DriverProfile?

  // On-demand rides
  passengerRides RideRequest[] @relation("PassengerRides")
  driverRides    RideRequest[] @relation("DriverRides")

  @@map("users")
  @@schema("auth")
}

// ─────────────────────────────────────────────────────────
// DRIVER PROFILE
// ─────────────────────────────────────────────────────────

model DriverProfile {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  licenseNumber String   @unique @map("license_number")
  isApproved    Boolean  @default(false) @map("is_approved")
  isAvailable   Boolean  @default(false) @map("is_available")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicles              Vehicle[]
  vehicleChangeRequests VehicleChangeRequest[]

  @@map("driver_profiles")
  @@schema("auth")
}

// ─────────────────────────────────────────────────────────
// VEHICLE
// ─────────────────────────────────────────────────────────

model Vehicle {
  id            String  @id @default(uuid())
  driverId      String  @map("driver_id")
  vehicleNumber String  @unique @map("vehicle_number")
  vehicleType   String  @map("vehicle_type")
  brand         String?
  model         String?
  color         String?
  isActive      Boolean @default(true) @map("is_active")

  // APPROVED | PENDING | REJECTED
  approvalStatus String @default("APPROVED") @map("approval_status")

  requestedAt DateTime? @map("requested_at")
  approvedAt  DateTime? @map("approved_at")
  rejectedAt  DateTime? @map("rejected_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  driver         DriverProfile          @relation(fields: [driverId], references: [id], onDelete: Cascade)
  rideRequests   RideRequest[]
  changeRequests VehicleChangeRequest[]

  @@index([driverId])
  @@index([vehicleType])
  @@index([approvalStatus])
  @@map("vehicles")
  @@schema("auth")
}

// ─────────────────────────────────────────────────────────
// VEHICLE CHANGE REQUEST
// ─────────────────────────────────────────────────────────

model VehicleChangeRequest {
  id String @id @default(uuid())

  driverId  String @map("driver_id")
  vehicleId String @map("vehicle_id")

  vehicleNumber String  @map("vehicle_number")
  vehicleType   String  @map("vehicle_type")
  brand         String?
  model         String?
  color         String?

  // PENDING | APPROVED | REJECTED
  status String @default("PENDING")

  requestedAt DateTime  @default(now()) @map("requested_at")
  reviewedAt  DateTime? @map("reviewed_at")

  driver  DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicle Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([driverId, status])
  @@index([vehicleId, status])
  @@index([status])
  @@map("vehicle_change_requests")
  @@schema("auth")
}

// ─────────────────────────────────────────────────────────
// SAVED ROUTES
// ─────────────────────────────────────────────────────────

model SavedRoute {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  label     String
  fromLat   Float    @map("from_lat")
  fromLng   Float    @map("from_lng")
  toLat     Float    @map("to_lat")
  toLng     Float    @map("to_lng")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("saved_routes")
  @@schema("auth")
}

// ─────────────────────────────────────────────────────────
// REVIEW
// ─────────────────────────────────────────────────────────

model Review {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  placeId   String   @map("place_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@map("reviews")
  @@schema("auth")
}

// ─────────────────────────────────────────────────────────
// GEO SCHEMA
// ─────────────────────────────────────────────────────────

model Place {
  id                String            @id @default(uuid())
  name              String
  category          String
  address           String?
  rating            Float             @default(0)
  openHours         String?
  lat               Float
  lng               Float
  createdAt         DateTime          @default(now())
  osmId             String?           @unique
  reviews           Review[]
  nearbySpecialties NearbySpecialty[]

  @@map("places")
  @@schema("geo")
}

model NearbySpecialty {
  id            String   @id @default(uuid())
  placeId       String   @map("place_id")
  specialtyType String   @map("specialty_type")
  aiScore       Float?   @map("ai_score")
  createdAt     DateTime @default(now()) @map("created_at")

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@map("nearby_specialties")
  @@schema("geo")
}

// ─────────────────────────────────────────────────────────
// OLD GEO ROUTING MODELS
// ─────────────────────────────────────────────────────────

model Route {
  id          String     @id @default(uuid())
  name        String
  transitType String
  startPoint  String
  endPoint    String
  baseFare    Float
  perKmRate   Float
  isActive    Boolean    @default(true)
  stops       Stop[]
  schedules   Schedule[]

  @@schema("geo")
}

model Stop {
  id       String @id @default(uuid())
  routeId  String
  route    Route  @relation(fields: [routeId], references: [id])
  name     String
  lat      Float
  lng      Float
  sequence Int

  @@schema("geo")
}

model Schedule {
  id            String   @id @default(uuid())
  routeId       String
  route         Route    @relation(fields: [routeId], references: [id])
  departureTime String
  arrivalTime   String
  daysActive    String[]
  vehicleNumber String?

  @@schema("geo")
}

// ─────────────────────────────────────────────────────────
// TRANSIT SCHEMA
// ─────────────────────────────────────────────────────────

model TransitRoute {
  id             String   @id @default(uuid())
  routeName      String   @map("route_name")
  routeNumber    String   @unique @map("route_number")
  transitType    String   @map("transit_type")
  origin         String
  destination    String
  originLat      Float    @map("origin_lat")
  originLng      Float    @map("origin_lng")
  destinationLat Float    @map("destination_lat")
  destinationLng Float    @map("destination_lng")
  baseFare       Float    @map("base_fare")
  firstDeparture String?  @map("first_departure")
  lastDeparture  String?  @map("last_departure")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  stops    TransitStop[]
  trips    Trip[]
  bookings Booking[]

  @@map("transit_routes")
  @@schema("transit")
}

model TransitStop {
  id                 String  @id @default(uuid())
  routeId            String  @map("route_id")
  stopName           String  @map("stop_name")
  stopCode           String? @map("stop_code")
  stopOrder          Int     @map("stop_order")
  lat                Float
  lng                Float
  arrivalTime        String? @map("arrival_time")
  departureTime      String? @map("departure_time")
  distanceFromPrevKm Float?  @map("distance_from_prev_km")

  route            TransitRoute   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  currentTrackings LiveTracking[] @relation("CurrentStop")
  nextTrackings    LiveTracking[] @relation("NextStop")
  boardingBookings Booking[]      @relation("BoardingStop")
  dropBookings     Booking[]      @relation("DropStop")

  @@unique([routeId, stopOrder])
  @@map("transit_stops")
  @@schema("transit")
}

model Trip {
  id             String   @id @default(uuid())
  routeId        String   @map("route_id")
  vehicleNumber  String   @map("vehicle_number")
  vehicleType    String   @map("vehicle_type")
  driverName     String?  @map("driver_name")
  driverPhone    String?  @map("driver_phone")
  departureTime  String   @map("departure_time")
  arrivalTime    String?  @map("arrival_time")
  travelDate     DateTime @map("travel_date")
  status         String   @default("scheduled")
  totalSeats     Int      @map("total_seats")
  availableSeats Int      @map("available_seats")
  createdAt      DateTime @default(now()) @map("created_at")

  route        TransitRoute  @relation(fields: [routeId], references: [id], onDelete: Restrict)
  liveTracking LiveTracking?
  bookings     Booking[]

  @@map("trips")
  @@schema("transit")
}

model LiveTracking {
  id            String   @id @default(uuid())
  tripId        String   @unique @map("trip_id")
  currentStopId String?  @map("current_stop_id")
  nextStopId    String?  @map("next_stop_id")
  currentLat    Float    @map("current_lat")
  currentLng    Float    @map("current_lng")
  delayMinutes  Int      @default(0) @map("delay_minutes")
  speedKmph     Float?   @map("speed_kmph")
  bearing       Float?
  updatedAt     DateTime @updatedAt @map("updated_at")

  trip        Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  currentStop TransitStop? @relation("CurrentStop", fields: [currentStopId], references: [id], onDelete: SetNull)
  nextStop    TransitStop? @relation("NextStop", fields: [nextStopId], references: [id], onDelete: SetNull)

  @@map("live_tracking")
  @@schema("transit")
}

// ─────────────────────────────────────────────────────────
// BOOKING SCHEMA
// ─────────────────────────────────────────────────────────

model Booking {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  routeId        String   @map("route_id")
  tripId         String?  @map("trip_id")
  boardingStopId String?  @map("boarding_stop_id")
  dropStopId     String?  @map("drop_stop_id")
  transitType    String   @map("transit_type")
  seatNumber     String?  @map("seat_number")
  farePaid       Float    @map("fare_paid")
  travelDate     DateTime @map("travel_date")
  status         String   @default("pending")
  bookedAt       DateTime @default(now()) @map("booked_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  route        TransitRoute @relation(fields: [routeId], references: [id], onDelete: Restrict)
  trip         Trip?        @relation(fields: [tripId], references: [id], onDelete: Restrict)
  boardingStop TransitStop? @relation("BoardingStop", fields: [boardingStopId], references: [id], onDelete: SetNull)
  dropStop     TransitStop? @relation("DropStop", fields: [dropStopId], references: [id], onDelete: SetNull)
  payment      Payment?

  @@map("bookings")
  @@schema("booking")
}

model Payment {
  id            String    @id @default(uuid())
  bookingId     String    @unique @map("booking_id")
  amount        Float
  method        String
  status        String    @default("pending")
  transactionId String?   @unique @map("transaction_id")
  paidAt        DateTime? @map("paid_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@map("payments")
  @@schema("booking")
}

// ─────────────────────────────────────────────────────────
// ON-DEMAND RIDE REQUEST
// ─────────────────────────────────────────────────────────

model RideRequest {
  id String @id @default(uuid())

  // Passenger
  passengerId String @map("passenger_id")

  // Driver
  driverId String? @map("driver_id")

  // Vehicle
  vehicleId String? @map("vehicle_id")

  // Pickup
  pickupLatitude  Float   @map("pickup_latitude")
  pickupLongitude Float   @map("pickup_longitude")
  pickupAddress   String? @map("pickup_address")

  // Destination
  destinationLatitude  Float   @map("destination_latitude")
  destinationLongitude Float   @map("destination_longitude")
  destinationAddress   String? @map("destination_address")

  // Route
  distanceKm      Float? @map("distance_km")
  durationMinutes Int?   @map("duration_minutes")

  // Fare
  estimatedFare Float   @map("estimated_fare")
  finalFare     Float?  @map("final_fare")
  vehicleType   String
  // Passenger OTP - store hash, not plain OTP
  otpHash       String? @map("otp_hash")

  // REQUESTED
  // ACCEPTED
  // DRIVER_ARRIVING
  // DRIVER_ARRIVED
  // OTP_VERIFIED
  // IN_PROGRESS
  // COMPLETED
  // CANCELLED
  // REJECTED
  status String @default("REQUESTED")

  // Timestamps
  requestedAt DateTime  @default(now()) @map("requested_at")
  acceptedAt  DateTime? @map("accepted_at")
  arrivedAt   DateTime? @map("arrived_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  cancelledAt DateTime? @map("cancelled_at")

  // Relations
  passenger User     @relation("PassengerRides", fields: [passengerId], references: [id], onDelete: Restrict)
  driver    User?    @relation("DriverRides", fields: [driverId], references: [id], onDelete: SetNull)
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([passengerId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([status])
  @@map("ride_requests")
  @@schema("booking")
}
